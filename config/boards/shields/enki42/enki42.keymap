#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define _ &kp
#define _n &none
#define _t &trans

#define DEF 0
#define GAM 1
#define GFN 2
#define SYM 3
#define NAV 4
#define NUM 5
#define ALT 6
#define CMD 7

#define MEH(key) LS(LC(LA(key)))

#define SQT GRAVE
#define DQT LS(GRAVE)
#define GRV RA(GRAVE)
#define PIP LS(BSLH)
#define BSL RA(BSLH)
#define NBSP RA(SPACE)

#define NSPC LC(LG(RIGHT))
#define PSPC LC(LG(LEFT))

&sk {
	quick-release; // Avoids "THis" problem (double capitalization)
    release-after-ms = <60000>;
};

&mmv {
    time-to-max-speed-ms = <1000>;
};

&msc {
    time-to-max-speed-ms = <600>;
};

/ {
    combos {
        compatible = "zmk,combos";
        timeout-ms = <50>;
        require-prior-idle-ms = <250>;
        
        combo_reset_central {
            key-positions = <46 47>;
            bindings = <&bootloader>;
            require-prior-idle-ms = <2000>;
            layers = <GFN>;
        };

        combo_toggle_usb_ble {
            key-positions = <20 21>;
            bindings = <&out OUT_TOG>;
            require-prior-idle-ms = <2000>;
            layers = <GFN>;
        };

        combo_soft_off {
            key-positions = <38 39>;
            bindings = <&soft_off>;
            require-prior-idle-ms = <2000>;
            layers = <GFN>;
        };
    };

    macros {
		lc: mo_layer_switch_with_an_embeded_cancel_tap_for_clearing_any_queued_sticky_mods_on_press {
			compatible = "zmk,behavior-macro-one-param";
			label = "mo_layer/cancel";
			wait-ms = <0>;
			tap-ms = <0>;
			#binding-cells = <1>;
			bindings =
			<&macro_tap>,
			<&kp K_CANCEL &macro_param_1to1>,
			<&macro_press>,
			<&mo MACRO_PLACEHOLDER>,
			<&macro_pause_for_release>,
			<&macro_param_1to1>,
			<&macro_release>,
			<&mo MACRO_PLACEHOLDER>;
		};
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers  = <NAV SYM>;
            then-layer = <NUM>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        def_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |       |
// |       |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |       |
// |       |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   |       |
//               |     |      |      |      |        |  |       |      |       |       |      |
            bindings = <
_n _n   _n     _n     _n       _n                                _n      _n        _n       _n     _n     _n     
_n _ Q  _ W    _ E    _ R      _ T                               _ Y     _ U       _ I      _ O    _ P    _n
_n _ A  _ S    _ D    _ F      _ G                               _ H     _ J       _ K      _ L    _ SEMI _n
_n _ Z  _ X    _ C    _ V      _ B      _ C_MUTE      _n         _ N     _ M       _ COMMA  _ DOT  _ FSLH _n
        _n     _n     &tog GAM _ SPACE  &lc NAV                  &lc SYM &mo GFN   &mo ALT  _n     _n
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        gam_layer {
            bindings = <
_n _n           _n           _n           _n              _n              _n           _n             _n             _n              _n      _n            
_n _ TAB        _n           &msc SCRL_UP &msc SCRL_DOWN  _ R             _ ESC        _n             &mmv MOVE_UP   _n              _ TAB   _n
_n _ LSFT       &mkp RCLK    &mkp MCLK    &mkp LCLK       _ F             _n           &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT _ RSFT  _n
_n _t          _t            _t           _t              _ ESC  _n   _n  _n           _n             _n             _n              _ RCTRL _n 
               _n     _n     &tog GAM     _t              _t              _t           _t             _t             _n              _n
            >;
        };

        gfn_layer {
            bindings = <
_n _n           _n           _n           _n          _n                  _n           _n           _n           _n           _n          _n
_n _n           _ C_VOL_DN   _ C_MUTE     _ C_VOL_UP  _n                  _n           _ F13        _ F14        _ F15        _ F16       _n
_n _n           _ C_PREV     _ C_PP       _ C_NEXT    _n                  _n           _ F17        _ F18        _ F19        _ F20       _n
_n _n           _n           _n           _n          _n       _n _n      _n           _ F21        _ F22        _ F23        _ F24       _n
                    _n _n    _t           _t          _t                  _t           _t           _t  _n _n  
            >;
        };

        sym_layer {
            bindings = <
_n _n           _n           _n           _n          _n              _n           _n           _n           _n           _n         _n
_n _ N1         _ N2         _ N3         _ N4        _ N5            _ N6         _ N7         _ N8         _ N9         _ N0       _n
_n _ SEMI       _ GRV        _ SQT        _ DQT       _ MINUS         _ PLUS       &sk LSHFT    &sk LCTRL    &sk LALT     &sk LGUI   _n
_n _ BSL        _ APOS       _ LS(LBKT)   _ LBKT      _ UNDER  _n _n  _ EQUAL      _ RBKT       _ LS(RBKT)   _ PIP        _ BSLH     _n
                      _n _n  _t           _t          _t              _t           _t           _t  _n _n 
            >;
        };

        nav_layer {
            bindings = <
_n _n           _n           _n           _n          _n                      _n           _n           _n           _n           _n         _n
_n _n           _n           _n           _n          _n                      _ ESC        _ HOME       _ UP         _ END        _ PG_UP    _n           
_n &sk LGUI     &sk LALT     &sk LCTRL    &sk LSHFT   _n                      _ RET        _ LEFT       _ DOWN       _ RIGHT      _ PG_DN    _n
_n _ LC(Z)       _ LC(X)     _ LC(C)      _ LC(V)     _n     _n         _n    _ TAB        _ BSPC       _ DEL        _ CAPS       _ KP_NUM   _n        
                    _n &mo CMD _t         _t          _t                      _t           _t           _t  _n _n   
            >;
        };

        num_layer {
            bindings = <
_n _n           _n           _n           _n          _n              _n           _n           _n           _n           _n         _n
_n _ KP_N1      _ KP_N2      _ KP_N3      _ KP_N4     _ KP_N5         _ KP_N6      _ KP_N7      _ KP_N8      _ KP_N9      _ KP_N0    _n
_n &sk LGUI     &sk LALT     &sk LCTRL    &sk LSHFT   _ F11           _ F12        &sk LSHFT    &sk LCTRL    &sk LALT     &sk LGUI   _n
_n _ F1         _ F2         _ F3         _ F4        _ F5  _n    _n  _ F10        _ F9         _ F8         _ F7         _ F6       _n
                     _n _n   _t           _t          _t              _t           _t           _t  _n _n  
            >;
        };

        alt_layer {
            bindings = <
_n _n           _n           _n           _n          _n              _n           _n           _n           _n           _n         _n
_n _ RA(Q)      _ RA(W)      _ RA(E)      _ RA(R)     _ RA(T)         _ RA(Y)      _ RA(U)      _ RA(I)      _ RA(O)      _ RA(P)    _n
_n _ RA(A)      _ RA(S)      _ RA(D)      _ RA(F)     _ RA(G)         _ RA(H)      _ RA(J)      _ RA(K)      _ RA(L)      _ RA(SEMI) _n
_n _ RA(Z)      _ RA(X)      _ RA(C)      _ RA(V)     _ RA(B)  _n _n  _ RA(N)      _ RA(M)      _ RA(COMMA)  _ RA(DOT)    _ RA(FSLH) _n
                     _n _n   _t           _ NBSP      _ LSHFT         _t           _t           _t    _n _n 
            >;
        };

        cmd_layer {
            bindings = <
_n _n           _n           _n           _n          _n              _n           _n           _n           _n          _n              _n
_n _ N5         _ N1         _ N2         _ N3        _ N4            &out OUT_TOG &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR_ALL _n
_n _ N0         _ N6         _ N7         _ N8        _ N9            _n           _n          _n          _n           _n               _n
_n _ G          _ J          _ I          _ M         _ T  _n     _n  _ KP_NUM     _n          _n          _n           _n               _n
                     _n _n   _ ESC        _ RET       _t              _t           _t          _t  _n _n
            >;
        };

    };
};
